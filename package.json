{
  "name": "monster-deleter",
  "version": "1.0.0",
  "description": "召唤大将怪兽把文件送进 Windows 回收站",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "electron-vite build",
    "package:win": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.monsterdeleter.app",
    "productName": "MonsterDeleter",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
